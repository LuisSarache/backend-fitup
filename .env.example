DATABASE_URL="postgresql://user:password@localhost:5432/fitup"
JWT_SECRET="mude-para-um-segredo-longo-e-aleatorio-minimo-32-chars"
JWT_REFRESH_SECRET="outro-segredo-longo-e-aleatorio-minimo-32-chars"
PORT=3000

# Origem permitida pelo CORS (ex: domínio do painel web, ou * para dev)
ALLOWED_ORIGIN="*"

# URL do frontend para o link de reset de senha
FRONTEND_URL="https://fitup.app"

# Nodemailer (ex: Gmail com senha de app)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="seu@email.com"
SMTP_PASS="sua-senha-de-app"
SMTP_FROM="FitUp <noreply@fitup.app>"
